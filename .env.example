# SDK tool-output framing is enabled by default; summary trust rules always apply.
ARTEX_UNTRUSTED_BOUNDARY=1

# Data envelope around agent- and target-derived text in planner, worker and digest
# messages, plus the planner goal anchor; enabled by default. 0 disables both; the
# code-owned prompt rules still apply.
ARTEX_DATA_ENVELOPE=1

# Schema migrations: start although the database holds a migration this binary does
# not ship, up to and including the given four-digit version. Unset by default. Use
# it only while the right release or a restore is prepared: see docs/schema-upgrade.md.
# ARTEX_SCHEMA_ALLOW_NEWER=5002

# Tool RAG observation (planner rounds and worker runs): records what a lexical tool
# filter would have kept, next to the tools the model called. It never changes the
# tool list and never blocks. Unset or observe = on (the default); off, 0, false or no
# = off. 1, true, on, yes and filter only observe and log one warning. docker-compose.yml
# passes both variables to the container; an empty value means the default.
# See docs/tool-rag-observation.md.
# ARTEX_TOOL_RAG=observe
# Candidates the ranking keeps (default 12); changes only what the rows say.
# ARTEX_TOOL_RAG_TOPK=12

# Docker deployment configuration (copy to .env)
# The image is built locally by `docker compose build`; there is no registry tag.
# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0
# to reach it from another machine or from Windows when ARTEX runs inside WSL.
ARTEX_BIND_ADDR=127.0.0.1
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
# The bundled PostgreSQL has no network and does not listen on TCP; artex reaches it
# through a Unix socket in a shared volume (see docker-compose.yml). Consequences:
#   - Nothing else can connect to it, and port 5432 is not published. For a shell use
#     `docker compose exec postgres psql -U artex -d artex` (it asks for the password,
#     or: PGPASSWORD="$POSTGRES_PASSWORD" docker compose exec -e PGPASSWORD postgres psql ...).
#   - On a host with SELinux enforcing (Fedora, RHEL) the shared volume needs the :z
#     label, which docker-compose.yml sets. Custom Compose files must set it too.
#   - A NEW database volume requires the password for every connection (scram-sha-256).
#     An EXISTING volume keeps the pg_hba.conf it was created with, which trusts local
#     connections without a password. Nothing changes it for you. To require the
#     password on an existing volume, run these two steps once, from this directory:
#       1. Make the stored role password equal POSTGRES_PASSWORD (read inside the
#          container, never put on a command line):
#            docker compose exec -T postgres sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1' <<'SQL'
#            \getenv pw POSTGRES_PASSWORD
#            \getenv usr POSTGRES_USER
#            ALTER ROLE :"usr" PASSWORD :'pw';
#            SQL
#       2. Require scram in pg_hba.conf and reload:
#            docker compose exec -T -u postgres postgres sh -c 'sed -i -E "s/[[:space:]]trust\$/ scram-sha-256/" "$PGDATA/pg_hba.conf" && psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tc "select pg_reload_conf()"'
#     Check afterwards: `docker compose exec postgres psql -U artex -d artex -w -c 'select 1'`
#     must fail with "no password supplied", and ARTEX must still start.
#   - After upgrading to 0.5.18m or later from an earlier release, rotate the database password and the
#     model provider API keys, and follow the other post-upgrade actions in GHSA-x67q-r3xq-3ghq.
#   - scripts/backup.sh and reset-password.sh -m docker read POSTGRES_PASSWORD from here.
#   - Custom Compose files or an external PostgreSQL over TCP keep working, but agent
#     tools may then reach the database: the server warns about it at start.

# Agent tool isolation (Docker image). Unset or empty = on (the default). ARTEX_TOOL_ISOLATION=off
# keeps the old behaviour (tools run as the server's user); it never stops the server or a
# session: it only adds the warnings. Environment only; there is no settings key for it.
# ARTEX_TOOL_ISOLATION=off

# Signal notifications (only with docker-compose.signal.yml; ignored otherwise).
# Password of the sidecar's database role; required when the Signal override is used, a long random value.
ARTEX_SIGNAL_DB_PASSWORD=
# Database role of the Signal sidecar (default artex_signal); it must differ from POSTGRES_USER.
# ARTEX_SIGNAL_DB_ROLE=artex_signal
# Image of the Signal sidecar (default: the published artex-signal image). Pin a digest deliberately.
# ARTEX_SIGNAL_IMAGE=ghcr.io/mkilijanek/artex-signal:latest

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Compact worker launch data (opt-in). Keep 0 until a live comparison run supports
# enabling it; 1 selects dependency evidence and bounded target assets per worker.
ARTEX_WORKER_CONTEXT=0

# Experimental planner/reference/trace context; independent of worker launch data.
ARTEX_BOUNDED_CONTEXT=0

# Experimental prompt segmentation and source-identical summary memoization.
ARTEX_CACHE_PREFIX=0
ARTEX_COMPACTION_MEMO=0
